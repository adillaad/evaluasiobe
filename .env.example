#--------------------------------------------------------------------------
# PENGATURAN APLIKASI UTAMA
#--------------------------------------------------------------------------

# Nama aplikasi, akan muncul di beberapa bagian website.
APP_NAME="Sistem Penjamin Mutu"

# Lingkungan aplikasi. Ganti menjadi 'production' saat website sudah online.
# 'local' untuk development, 'production' untuk live.
APP_ENV=local

# Kunci enkripsi unik untuk aplikasi. Generate dengan perintah 'php artisan key:generate'.
# JANGAN disalin dari proyek lain.
APP_KEY=

# Mode Debug. 'true' untuk menampilkan error detail saat development.
# HARUS 'false' saat website sudah online untuk.
APP_DEBUG=true

# URL utama aplikasi Anda. Sesuaikan jika menggunakan domain lain.
APP_URL=http://127.0.0.1:8000/

#--------------------------------------------------------------------------
# PENGATURAN LOGGING
#--------------------------------------------------------------------------

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#--------------------------------------------------------------------------
# PENGATURAN DATABASE
#--------------------------------------------------------------------------

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
# Nama database di MySQL/phpMyAdmin.
DB_DATABASE=
# Username untuk mengakses database. Defaultnya biasanya 'root'.
DB_USERNAME=
# Password untuk username database. Defaultnya biasanya kosong.
DB_PASSWORD=

#--------------------------------------------------------------------------
# PENGATURAN LOGIN DENGAN GOOGLE (OAUTH)
# Dapatkan kredensial ini dari Google Cloud Platform Console.
#--------------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL ini HARUS SAMA PERSIS dengan yang didaftarkan di Google Cloud Console.
GOOGLE_CALLBACK_REDIRECT=http://127.0.0.1:8000/auth/google/callback

#--------------------------------------------------------------------------
# PENGATURAN DRIVER BAWAAN LARAVEL
# (Biasanya tidak perlu diubah untuk proyek standar)
#--------------------------------------------------------------------------

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
MEMCACHED_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#--------------------------------------------------------------------------
# PENGATURAN PENGIRIMAN EMAIL (SMTP)
# Digunakan untuk fitur seperti reset password, notifikasi, dll.
#--------------------------------------------------------------------------

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Alamat email yang digunakan untuk mengirim email (misal: no-reply@domain.com).
MAIL_USERNAME=
# PENTING: Jika menggunakan Gmail, ini BUKAN password login biasa.
# Anda harus membuat "App Password" dari pengaturan keamanan akun Google Anda.
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
# Alamat email yang akan muncul sebagai pengirim.
MAIL_FROM_ADDRESS=
# Nama yang akan muncul sebagai pengirim.
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

#--------------------------------------------------------------------------
# PENGATURAN EXPORT PDF (HOSTING LINUX / CPANEL)
#--------------------------------------------------------------------------

WKHTMLTOPDF_BINARY=/home/USERNAME/evaluasiobe/bin/wkhtmltopdf
WKHTMLTOIMAGE_BINARY=/home/USERNAME/evaluasiobe/bin/wkhtmltoimage